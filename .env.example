# Copy this file to .env (local dev / docker compose) or into Railway's
# service variables (cloud). Never commit real keys — this template exists so
# a fresh clone always knows exactly which variables the system expects.
#
#   cp .env.example .env    # local / compose
#
# On Railway set the same variables under the service's Variables tab. Values
# left blank are treated as "not configured" (e.g. no Bybit keys = Binance-only).

# ── Binance ──────────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = Binance Futures testnet (default, safe). Set to false ONLY when you
# are ready to trade with real funds.
LIQ_TESTNET=true

# Fixed dollar amount at risk per trade; position notional = USD * LEVERAGE.
LIQ_RISK_USD=500
LIQ_LEVERAGE=5

# ── Bybit mirror (optional — blank keys = Binance-only) ─────────────────────
BYBIT_ENABLED=true
# true = Bybit Demo Trading. Set false only for real funds.
BYBIT_TESTNET=true
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_RISK_USD=500
BYBIT_LEVERAGE=5
BYBIT_MAX_CONCURRENT_POSITIONS=3

# ── Dashboard (read-only; hosts /healthz for Railway) ───────────────────────
# Railway injects PORT automatically; leave these unset in the cloud.
# Locally the dash serves http://127.0.0.1:8765.
DASH_HOST=
DASH_PORT=8765
DASH_REFRESH_SECONDS=2
# Set these to the real starting balance of each exchange account so the
# dashboard can show true equity AND verify its PnL math against the
# exchange (exchange PnL = equity − starting balance).
DASH_START_BALANCE_BINANCE=0
DASH_START_BALANCE_BYBIT=0
# Max |dash PnL − exchange PnL| (USD) before the PnL verification panel
# flags a WARN instead of OK.
# PNL_VERIFY_TOLERANCE_USD=5

# ── Data location (cloud) ────────────────────────────────────────────────────
# In the container this is already set to /data by the Dockerfile (Railway
# volume). Override only if you mount the volume somewhere else.
# LIQ_DATA_DIR=/data

# ── Data retention (maintenance.py trims these back) ────────────────────────
# MAINTENANCE_INTERVAL_SECONDS=3600
# MAX_LIQ_CSV_ROWS=250000
# MAX_PERFORMANCE_ROWS=50000
# MAX_TRADE_LOG_LINES=50000
